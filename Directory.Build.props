<Project>

    <PropertyGroup>
        <Company>Starion Group S.A.</Company>
        <Copyright>Copyright 2017-2026 Starion Group S.A.</Copyright>
        <RepositoryUrl>https://github.com/STARIONGROUP/reqifsharp.git</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <Deterministic>true</Deterministic>
        <NeutralLanguage>en-US</NeutralLanguage>
        <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
        <LangVersion>14.0</LangVersion>
    </PropertyGroup>

    <!--
        Test projects are identified by name: IsPackable is set in the project file itself, which is
        evaluated after this file, so it cannot be used as a condition here.
    -->
    <PropertyGroup>
        <IsReqIFSharpTestProject>$(MSBuildProjectName.EndsWith('.Tests'))</IsReqIFSharpTestProject>
    </PropertyGroup>

    <!-- packaging settings shared by the published library projects -->
    <PropertyGroup Condition="'$(IsReqIFSharpTestProject)' != 'true'">
        <PackageProjectUrl>https://reqifsharp.org</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageTags>ReqIF mbse modeltopia</PackageTags>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <RequireLicenseAcceptance>false</RequireLicenseAcceptance>
        <IncludeSource>true</IncludeSource>
        <IncludeSymbols>true</IncludeSymbols>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GenerateSBOM>true</GenerateSBOM>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsReqIFSharpTestProject)' != 'true'">
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="\" />
        <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" />
    </ItemGroup>

</Project>
